# ─────────────────────────────────────────────────────────────────
# Environment & secrets
# ─────────────────────────────────────────────────────────────────
.env
.env.*.local
.env.local
*.pem
*.key

# ─────────────────────────────────────────────────────────────────
# Data (web caches, processed artifacts -- never commit)
# ─────────────────────────────────────────────────────────────────
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.html
*.htm
*.parquet

# ─────────────────────────────────────────────────────────────────
# Python (api/)
# DO NOT add `lib/` here -- the InsightFinder repo had this exact
# rule and it silently swallowed web/lib/api.ts. The Python venv
# lives at .venv/ which is already excluded.
# ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# uv lockfile is committed; cache is not
.uv/

# ─────────────────────────────────────────────────────────────────
# Node (web/)
# ─────────────────────────────────────────────────────────────────
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts
.pnpm-store/
.yarn/
.npm/

# ─────────────────────────────────────────────────────────────────
# Editors / OS
# ─────────────────────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ─────────────────────────────────────────────────────────────────
# Logs
# ─────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─────────────────────────────────────────────────────────────────
# Postgres data volume (if mounted locally)
# ─────────────────────────────────────────────────────────────────
.postgres-data/
pgdata/

# Vercel
.vercel
