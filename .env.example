# ─────────────────────────────────────────────────────────────────
# AI Business Workflow Automator -- environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────
# Local docker-compose default. For prod use Neon or another managed
# Postgres -- the URL format is identical.
DATABASE_URL=postgresql://workflow:workflow@localhost:5432/workflow_automator

# ─── LLM ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# Models (override here if you want to swap)
GENERATOR_MODEL=gpt-4o-mini
EVALUATOR_MODEL=gpt-4o-mini

# ─── Web search ──────────────────────────────────────────────────
# Brave Search free tier: 2k requests / month. Sign up at
# https://api.search.brave.com/app/keys (no card required).
# Leave blank to skip the web-search step (research uses URL scrape only).
BRAVE_API_KEY=

# ─── Backend ─────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# ─── Cost guards ─────────────────────────────────────────────────
# Daily OpenAI spend cap, USD. Resets at UTC midnight.
DAILY_SPEND_CAP_USD=5.0
# Per-IP rate limits.
WORKFLOW_RUNS_PER_HOUR=5
ANSWER_REQUESTS_PER_HOUR=30
# Web-fetch caps for visitor URLs.
MAX_FETCH_BYTES=5242880        # 5 MB
FETCH_TIMEOUT_SECONDS=30

# ─── Frontend ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Observability ───────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── HTTP user agent ─────────────────────────────────────────────
# Used for the company-page fetch step. Some sites block generic UAs;
# putting a contact URL here is polite and avoids most blocks.
HTTP_USER_AGENT=AIBusinessWorkflowAutomator/0.1 (+https://github.com/Forward0125/AI-Business-Workflow-Automator)
